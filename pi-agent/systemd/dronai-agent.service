[Unit]
Description=DronAI Agent (MAVLink <-> DronAI backend bridge)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/opt/dronai/pi-agent
EnvironmentFile=/etc/dronai/agent.env
ExecStart=/opt/dronai/pi-agent/.venv/bin/python3 main.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
